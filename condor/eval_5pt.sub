# NOTE: Update paths below before use
# HTCondor submission for 5pt SFT evaluation with reject_term_increase=5
# 1000 workers, ~10 samples each (10270 total)

universe = vanilla
executable = /bin/bash
arguments = /path/to/RL_amplitudes_claude/scripts/run_eval_5pt_worker.sh $(Process) 1000 10270

output = /path/to/output/eval_5pt/$(Process).out
error = /path/to/output/eval_5pt/$(Process).err
log = /path/to/output/eval_5pt/condor.log

environment = "PYTHONPATH=/path/to/RL_amplitudes_claude/spinorhelicity:/path/to/RL_amplitudes_claude/src"

request_cpus = 2
request_memory = 8GB
request_disk = 2GB

getenv = True
+IsGPUJob = false
+MaxRuntime = 14400

queue 1000
